#!/usr/bin/env node
/**
 * sloplog-explore - Query wide events using natural language
 *
 * Usage:
 *   ./sloplog-explore -p "show me all errors from the api service" --partials ./my-partials.json
 *   ./sloplog-explore -p "find slow requests over 1 second" --period 7d
 */

import { spawn, execSync } from 'child_process';
import { readFileSync, existsSync } from 'fs';
import { join, dirname } from 'path';
import { fileURLToPath } from 'url';
import { createInterface } from 'readline';

const __dirname = dirname(fileURLToPath(import.meta.url));

// ANSI colors
const c = {
  reset: '\x1b[0m',
  dim: '\x1b[2m',
  bold: '\x1b[1m',
  cyan: '\x1b[36m',
  green: '\x1b[32m',
  yellow: '\x1b[33m',
  red: '\x1b[31m',
  magenta: '\x1b[35m',
  blue: '\x1b[34m',
};

// Parse args
const args = process.argv.slice(2);
let prompt = '';
let period = '24h';
let outputFile = join(__dirname, '.sloplog-explore-results.json');
let partialsFile = '';

for (let i = 0; i < args.length; i++) {
  if (args[i] === '-p' || args[i] === '--prompt') {
    prompt = args[++i];
  } else if (args[i] === '--period') {
    period = args[++i];
  } else if (args[i] === '-o' || args[i] === '--output') {
    outputFile = args[++i];
  } else if (args[i] === '--partials') {
    partialsFile = args[++i];
  } else if (args[i] === '-h' || args[i] === '--help') {
    console.log(`
${c.bold}sloplog-explore${c.reset} - Query wide events using natural language

${c.bold}Usage:${c.reset}
  ./sloplog-explore -p "your query" --partials <file> [options]

${c.bold}Required:${c.reset}
  -p, --prompt <query>     Natural language query
  --partials <file>        JSON schema file defining your partials (e.g., generated/sloplog.json)

${c.bold}Options:${c.reset}
  --period <period>        Time period: 1h, 6h, 24h, 7d, 14d (default: 24h)
  -o, --output <file>      Output file (default: .sloplog-explore-results.json)
  -h, --help               Show this help

${c.bold}Environment:${c.reset}
  SENTRY_AUTH_TOKEN        Sentry API token (or set in .sloplog-explore-config.json)
  SENTRY_ORG               Sentry organization slug

${c.bold}Examples:${c.reset}
  ./sloplog-explore -p "show me all errors" --partials ./generated/sloplog.json
  ./sloplog-explore -p "find slow db queries" --partials ./sloplog.json --period 7d

${c.bold}Partials file:${c.reset}
  The partials file should be a JSON schema (generated by sloplog codegen) that defines
  your custom partials structure. This tells the explorer what fields are available.
`);
    process.exit(0);
  }
}

if (!prompt) {
  console.error(`${c.red}Error: -p/--prompt is required${c.reset}`);
  process.exit(1);
}

if (!partialsFile) {
  console.error(`${c.red}Error: --partials is required${c.reset}`);
  console.error(`${c.dim}Provide the path to your sloplog JSON schema file (e.g., generated/sloplog.json)${c.reset}`);
  process.exit(1);
}

if (!existsSync(partialsFile)) {
  console.error(`${c.red}Error: Partials file not found: ${partialsFile}${c.reset}`);
  process.exit(1);
}

// Load partials schema
let partialsSchema;
try {
  partialsSchema = JSON.parse(readFileSync(partialsFile, 'utf-8'));
} catch (e) {
  console.error(`${c.red}Error: Could not parse partials file: ${e.message}${c.reset}`);
  process.exit(1);
}

// Load config
const configPath = join(__dirname, '.sloplog-explore-config.json');
let config = {};
if (existsSync(configPath)) {
  config = JSON.parse(readFileSync(configPath, 'utf-8'));
}

// Check for required env vars or config
const sentryToken = process.env.SENTRY_AUTH_TOKEN || config.sentryToken;
const sentryOrg = process.env.SENTRY_ORG || config.sentryOrg;

if (!sentryToken || !sentryOrg) {
  console.error(`
${c.red}Error: Missing Sentry configuration.${c.reset}

Set environment variables:
  ${c.cyan}export SENTRY_AUTH_TOKEN=sntrys_...${c.reset}
  ${c.cyan}export SENTRY_ORG=your-org-slug${c.reset}

Or create ${c.yellow}${configPath}${c.reset}:
  {
    "sentryToken": "sntrys_...",
    "sentryOrg": "your-org-slug"
  }
`);
  process.exit(1);
}

// Build field documentation from partials schema
function buildFieldDocs(schema) {
  const docs = [];
  const definitions = schema.definitions || {};
  const metadata = schema.metadata || {};

  for (const [name, def] of Object.entries(definitions)) {
    const meta = metadata[name] || {};
    const props = def.properties || {};
    const required = def.required || [];

    docs.push(`### ${name}${meta.repeatable ? ' (repeatable - stored as array)' : ''}`);
    if (def.description) docs.push(def.description);

    const fields = [];
    for (const [propName, propDef] of Object.entries(props)) {
      if (propName === 'type') continue; // Skip the type discriminator
      const req = required.includes(propName) ? 'required' : 'optional';
      const type = propDef.type || (propDef.enum ? `enum: ${propDef.enum.join('|')}` : 'unknown');
      fields.push(`  - ${name}.{index}.${propName}: ${type} (${req})`);
    }
    docs.push(fields.join('\n'));
    docs.push('');
  }

  return docs.join('\n');
}

const fieldDocs = buildFieldDocs(partialsSchema);

// System prompt with comprehensive documentation
const systemPrompt = `You are a sloplog query assistant. Convert natural language queries into Sentry API calls and fetch the results.

# SLOPLOG OVERVIEW

sloplog is a structured logging library that creates "wide events" - comprehensive logs capturing full request context.

## Wide Event Structure

Every wide event has:
- eventId: unique identifier (e.g., "evt_abc123")
- traceId: distributed trace ID (constant across services in a trace)
- service: { name, version, sloplogVersion, sloplogLanguage }
- originator: what triggered the event (http, cron, websocket)

Example event:
\`\`\`json
{
  "eventId": "evt_abc123",
  "traceId": "trace_xyz789",
  "service": { "name": "api-server", "version": "1.0.0" },
  "originator": { "type": "http", "method": "POST", "path": "/users" },
  "error": [{ "type": "error", "message": "Connection timeout", "stack": "..." }],
  "span": [{ "type": "span", "name": "db-query", "durationMs": 245 }]
}
\`\`\`

## Sentry Storage Format

When sent to Sentry, attributes are FLATTENED with dot-notation:
- eventId → eventId
- service.name → service.name
- error[0].message → error.0.message
- span[1].durationMs → span.1.durationMs

# USER'S PARTIALS SCHEMA

The user has defined these partials (from their schema file):

${fieldDocs}

# SENTRY QUERY API

## Table Format Endpoint
GET https://sentry.io/api/0/organizations/{org}/events/

Required parameters:
- dataset=logs (MUST be "logs" for sloplog data)
- field: fields to retrieve (repeat for multiple, max 20)

Optional parameters:
- query: Sentry search query string
- statsPeriod: 1h, 6h, 24h, 7d, 14d (default: 24h)
- project: project ID (-1 for all)
- environment: filter by environment
- sort: field to sort by (prefix with - for descending)
- per_page: results per page (max 100)

## Timeseries Format Endpoint
GET https://sentry.io/api/0/organizations/{org}/events-timeseries/

Required parameters:
- dataset=logs
- yAxis: aggregate function (e.g., count(), avg(span.0.durationMs))

Optional parameters:
- query: Sentry search query string
- statsPeriod: time range
- interval: bucket size in seconds
- groupBy: field(s) to group by

## Query Syntax

- Field existence: \`error.0.message:*\` (has any error)
- Exact match: \`service.name:api-server\`
- Wildcards: \`originator.path:/api/*\`
- Comparison: \`span.0.durationMs:>1000\`
- Negation: \`!error.0.message:*\` (no errors)
- OR: \`service.name:api OR service.name:worker\`
- AND: space-separate terms

## Common Queryable Fields

Base fields:
- eventId, traceId, timestamp
- service.name, service.version
- originator.type, originator.method, originator.path

Partials (use index for repeatable):
- error.0.message, error.0.stack, error.0.code
- span.0.name, span.0.durationMs
- log_message.0.message, log_message.0.level

# YOUR TASK

Organization: ${sentryOrg}
Auth token: Available as $SENTRY_AUTH_TOKEN environment variable
Time period: ${period}
Output file: ${outputFile}

1. Parse the user's natural language query
2. Construct the appropriate Sentry API call
3. Execute with curl using -s flag and $SENTRY_AUTH_TOKEN
4. Write results to the output file in this format:

\`\`\`json
{
  "query": {
    "natural": "the original user prompt",
    "sentry": "the sentry query string used",
    "fields": ["array", "of", "fields", "requested"],
    "type": "table" or "timeseries",
    "period": "${period}"
  },
  "results": { /* raw Sentry API response */ },
  "meta": {
    "timestamp": "ISO timestamp when query ran",
    "count": number_of_results
  }
}
\`\`\`

5. Print a brief summary of results

## Important Notes

- Always include: eventId, traceId, timestamp, service.name in table queries
- Add relevant fields based on what user is searching for
- For error queries, include error.0.message, error.0.stack
- For performance queries, include span fields
- Use -s flag with curl to suppress progress output
- URL-encode query parameters properly`;

// Build the full prompt
const fullPrompt = `User query: "${prompt}"

Time period: ${period}

Query Sentry and save results to ${outputFile}`;

// Header
console.log(`
${c.bold}${c.magenta}┌─────────────────────────────────────────┐${c.reset}
${c.bold}${c.magenta}│${c.reset}  ${c.bold}sloplog-explore${c.reset}                        ${c.bold}${c.magenta}│${c.reset}
${c.bold}${c.magenta}└─────────────────────────────────────────┘${c.reset}
`);
console.log(`${c.dim}Query:${c.reset}    "${c.cyan}${prompt}${c.reset}"`);
console.log(`${c.dim}Period:${c.reset}   ${period}`);
console.log(`${c.dim}Partials:${c.reset} ${partialsFile}`);
console.log(`${c.dim}Output:${c.reset}   ${outputFile}`);
console.log();

// Run claude with streaming JSON output
const claude = spawn('claude', [
  '--model', 'opus',
  '--print',
  '--output-format', 'stream-json',
  '--verbose',
  '--allowedTools', 'Bash(*),Write(*)',
  '-p', fullPrompt
], {
  env: {
    ...process.env,
    SENTRY_AUTH_TOKEN: sentryToken,
    SENTRY_ORG: sentryOrg,
    CLAUDE_CODE_SYSTEM_PROMPT: systemPrompt
  },
  stdio: ['inherit', 'pipe', 'pipe']
});

// Process streaming JSON output
const rl = createInterface({ input: claude.stdout });

let currentText = '';
let turnCount = 0;

rl.on('line', (line) => {
  try {
    const event = JSON.parse(line);
    handleStreamEvent(event);
  } catch (e) {
    // Ignore non-JSON lines
  }
});

claude.stderr.on('data', (data) => {
  // Ignore stderr for now (permission prompts etc go here)
});

function handleStreamEvent(event) {
  switch (event.type) {
    case 'system':
      if (event.subtype === 'init') {
        console.log(`${c.dim}Session: ${event.session_id.slice(0, 8)}...${c.reset}`);
        console.log();
      }
      break;

    case 'assistant':
      const content = event.message?.content || [];
      for (const block of content) {
        if (block.type === 'text') {
          // Accumulate text
          if (block.text && block.text !== currentText) {
            const newText = block.text.slice(currentText.length);
            process.stdout.write(newText);
            currentText = block.text;
          }
        } else if (block.type === 'tool_use') {
          turnCount++;
          console.log(`\n${c.yellow}━━━ Tool: ${block.name} ━━━${c.reset}`);

          if (block.name === 'Bash') {
            const cmd = block.input?.command || '';
            const desc = block.input?.description || '';
            if (desc) {
              console.log(`${c.dim}${desc}${c.reset}`);
            }
            // Show truncated command
            const displayCmd = cmd.length > 300 ? cmd.slice(0, 300) + '...' : cmd;
            console.log(`${c.cyan}$ ${displayCmd}${c.reset}`);
          } else if (block.name === 'Write') {
            console.log(`${c.dim}Writing to: ${block.input?.file_path}${c.reset}`);
          } else {
            console.log(`${c.dim}${JSON.stringify(block.input).slice(0, 100)}...${c.reset}`);
          }
        }
      }
      break;

    case 'user':
      // Tool result
      if (event.tool_use_result) {
        const result = event.tool_use_result;
        if (result.stdout) {
          const lines = result.stdout.split('\n');
          const preview = lines.slice(0, 5).join('\n');
          if (lines.length > 5) {
            console.log(`${c.dim}${preview}\n... (${lines.length - 5} more lines)${c.reset}`);
          } else if (preview.trim()) {
            console.log(`${c.dim}${preview}${c.reset}`);
          }
        }
        if (result.stderr) {
          console.log(`${c.red}${result.stderr.slice(0, 200)}${c.reset}`);
        }
        console.log(`${c.yellow}━━━━━━━━━━━━━━━━━━━━━${c.reset}\n`);
      }
      break;

    case 'result':
      console.log();
      if (event.is_error) {
        console.log(`${c.red}✗ Error: ${event.result}${c.reset}`);
      } else {
        console.log(`${c.green}✓ Complete${c.reset} ${c.dim}(${turnCount} tool calls, ${event.duration_ms}ms, $${event.total_cost_usd?.toFixed(4) || '?'})${c.reset}`);

        if (existsSync(outputFile)) {
          console.log(`\n${c.dim}Results saved to:${c.reset} ${c.cyan}${outputFile}${c.reset}`);

          // Try to show count
          try {
            const data = JSON.parse(readFileSync(outputFile, 'utf-8'));
            const count = data.meta?.count || data.results?.data?.length || '?';
            console.log(`${c.dim}Events found:${c.reset} ${c.bold}${count}${c.reset}`);
          } catch (e) {}

          console.log(`\n${c.dim}Opening viewer...${c.reset}`);

          // Auto-open the viewer
          try {
            execSync(`open "${join(__dirname, 'sloplog-viewer.html')}"`, { stdio: 'ignore' });
          } catch (e) {
            console.log(`${c.dim}Open manually: ${join(__dirname, 'sloplog-viewer.html')}${c.reset}`);
          }
        }
      }
      break;
  }
}

claude.on('close', (code) => {
  if (code !== 0) {
    console.error(`\n${c.red}Claude exited with code ${code}${c.reset}`);
    process.exit(code);
  }
});
